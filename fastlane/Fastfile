require "base64"
require "shellwords"
require "tmpdir"
require "xcodeproj"

default_platform(:ios)

# fastlane runs a lane's own Ruby from ./fastlane but runs actions from the
# repo root, so one relative path means two different things depending on who
# resolves it. Pin it absolutely instead of guessing which context applies.
def ksafe_project_path
  found = ["apple/KSafe.xcodeproj", "../apple/KSafe.xcodeproj"]
         .map { |p| File.expand_path(p) }
         .find { |p| File.exist?(p) }
  UI.user_error!("Could not find KSafe.xcodeproj. Run `xcodegen generate --spec apple/project.yml` first.") if found.nil?
  found
end

platform :ios do
  desc "Build KSafe (native SwiftUI, apple/) and upload it to TestFlight"
  lane :release_testflight do
    project_path = ksafe_project_path
    UI.message("Project: #{project_path}")

    team_id = ENV["APPLE_TEAM_ID"]
    key_id = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]

    # Apple rejects a build number it has already seen for the same
    # MARKETING_VERSION, so every upload needs a fresh one. GITHUB_RUN_NUMBER
    # increases by one per workflow run; local runs fall back to a timestamp.
    build_number = (ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%y%m%d%H%M")).to_s
    UI.message("Using build number #{build_number}")

    # Write the build number into the project rather than passing it as an
    # xcodebuild build-setting argument. gym appends :xcargs to BOTH the
    # archive and the -exportArchive command, and xcodebuild rejects build
    # settings during export — that combination fails with exit 64 and a bare
    # usage dump. Only flags legal for both commands may live in :xcargs.
    project = Xcodeproj::Project.open(project_path)
    project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings["CURRENT_PROJECT_VERSION"] = build_number
      end
    end
    project.save

    # Authenticates fastlane itself (the TestFlight upload at the end).
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false,
    )

    # xcodebuild is a separate process and cannot see the object above. On a
    # CI runner there is no signed-in Xcode account, so automatic signing has
    # no route to App Store Connect and fails with "No Accounts" / "No
    # profiles for 'com.ksafe.app' were found". Handing xcodebuild the .p8 on
    # disk plus the key and issuer ids lets it create and download the
    # distribution profile itself. These are plain flags, so they are safe in
    # :xcargs and reach the export step too, which needs them just as much.
    key_dir = Dir.mktmpdir("asc-key")
    key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(ENV["ASC_KEY_CONTENT"].to_s))
    File.chmod(0o600, key_path)

    auth_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path.shellescape,
      "-authenticationKeyID", key_id.to_s.shellescape,
      "-authenticationKeyIssuerID", issuer_id.to_s.shellescape,
    ].join(" ")

    begin
      # Sets CODE_SIGN_STYLE=Automatic and DEVELOPMENT_TEAM in the project,
      # which is why neither needs to be passed on the command line.
      update_code_signing_settings(
        use_automatic_signing: true,
        path: project_path,
        team_id: team_id,
      )

      build_app(
        project: project_path,
        scheme: "KSafe",
        configuration: "Release",
        export_method: "app-store",
        export_options: {
          signingStyle: "automatic",
          teamID: team_id,
        },
        xcargs: auth_args,
      )

      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        distribute_external: false,
      )
    ensure
      FileUtils.remove_entry(key_dir) if key_dir && File.directory?(key_dir)
    end
  end
end

platform :ios do
  desc "Ask App Store Connect what this API key can actually see and do"
  lane :diagnose_signing do
    team_id = ENV["APPLE_TEAM_ID"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false,
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

    def section(title)
      UI.message("")
      UI.important("=== #{title} ===")
      yield
    rescue StandardError => e
      UI.error("  FAILED: #{e.class}: #{e.message.to_s.lines.first.to_s.strip}")
    end

    UI.important("APPLE_TEAM_ID secret = #{team_id.inspect}")

    section("App Store Connect apps (needed to upload)") do
      apps = Spaceship::ConnectAPI::App.all
      UI.message("  #{apps.count} app(s) visible")
      apps.each { |a| UI.message("  - #{a.bundle_id}  (#{a.name})") }
      match = apps.find { |a| a.bundle_id == "com.ksafe.app" }
      UI.message(match ? "  OK: com.ksafe.app app record exists" : "  MISSING: no app record for com.ksafe.app")
    end

    section("Registered bundle IDs (needed to make a profile)") do
      ids = Spaceship::ConnectAPI::BundleId.all
      UI.message("  #{ids.count} bundle id(s) visible")
      ids.each { |b| UI.message("  - #{b.identifier}  (#{b.name})") }
      UI.message(ids.any? { |b| b.identifier == "com.ksafe.app" } ? "  OK: com.ksafe.app is registered" : "  MISSING: com.ksafe.app not registered")
    end

    section("Certificates") do
      certs = Spaceship::ConnectAPI::Certificate.all
      UI.message("  #{certs.count} certificate(s) visible")
      certs.each { |c| UI.message("  - #{c.certificate_type}  #{c.display_name}  expires #{c.expiration_date}") }
      dist = certs.select { |c| c.certificate_type.to_s.include?("DISTRIBUTION") }
      UI.message(dist.any? ? "  OK: #{dist.count} distribution certificate(s)" : "  NONE: no distribution certificate exists yet")
    end

    section("Provisioning profiles") do
      profiles = Spaceship::ConnectAPI::Profile.all
      UI.message("  #{profiles.count} profile(s) visible")
      profiles.each { |p| UI.message("  - #{p.name}  type=#{p.profile_type}  state=#{p.profile_state}") }
      store = profiles.select { |p| p.profile_type.to_s == "IOS_APP_STORE" }
      UI.message(store.any? ? "  OK: #{store.count} App Store profile(s)" : "  NONE: no IOS_APP_STORE profile exists")
    end

    # Opt-in only: Apple caps how many distribution certificates an account may
    # hold, so this actually consumes one. Everything above is read-only.
    if ENV["ALLOW_CERT_CREATE"] == "1"
      section("Can this key CREATE a distribution certificate? (creates one!)") do
        csr, _pkey = Spaceship::ConnectAPI::Certificate.create_certificate_signing_request
        cert = Spaceship::ConnectAPI::Certificate.create(
          certificate_type: Spaceship::ConnectAPI::Certificate::CertificateType::IOS_DISTRIBUTION,
          csr_content: csr.to_pem,
        )
        UI.success("  YES — created #{cert.certificate_type} id=#{cert.id}. Distribution signing is permitted.")
      end
    else
      UI.message("")
      UI.important("=== Distribution-certificate creation probe: skipped ===")
      UI.message("  Read-only run. Set ALLOW_CERT_CREATE=1 to test it — that consumes")
      UI.message("  one of the limited distribution certificate slots on the account.")
    end
  end
end
